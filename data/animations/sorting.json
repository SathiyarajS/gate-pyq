    {"name": "Merge sort", "algorithm": "merge", "array": [23, 32, 45, 69, 72, 73, 89, 97]},
    {"name": "Insertion sort", "algorithm": "insertion", "array": [23, 32, 45, 69, 72, 73, 89, 97]},
    {"name": "Quicksort", "algorithm": "quicksort", "pivot": "last", "array": [23, 32, 45, 69, 72, 73, 89, 97]}
   ],
